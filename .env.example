# Absolute origin for canonical links, Open Graph tags, and sitemap.xml.
#
# Only needed to override the default. Resolution order in src/lib/site.ts:
#   1. NEXT_PUBLIC_SITE_URL            — this file
#   2. NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL — set automatically on Vercel
#   3. https://amitspace.cloud         — any other production build
#   4. http://localhost:3000           — development only
#
# Set this on a preview deployment that should advertise its own URL, or when
# hosting somewhere other than Vercel. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://amitspace.cloud
